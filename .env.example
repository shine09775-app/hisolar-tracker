SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

LINE_LOGIN_CHANNEL_ID=your-shared-line-login-channel-id
LINE_LOGIN_CHANNEL_SECRET=your-shared-line-login-channel-secret
LINE_LOGIN_CALLBACK_URL=https://your-app.vercel.app/api/auth/line/callback
LINE_LOGIN_PROVIDER_NAMESPACE=hisolar-tracker-line

AUTH_FLOW_COOKIE_NAME=hs_auth_flow
AUTH_SESSION_COOKIE_NAME=hs_session
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

SUPABASE_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
SUPABASE_JWT_KID=your-imported-signing-key-id
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
